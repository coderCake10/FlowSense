# PostgreSQL/PostGIS
DB_USER=flowsense
DB_PASSWORD=flowsense_postgres
DB_URL=postgres://flowsense:flowsense_postgres@db:5432/flowsense

# Backend/Django/DRF
POSTGRES_DB = flowsense
POSTGRES_USER = postgres
POSTGRES_PASSWORD = postgres
POSTGRES_HOST = 127.0.0.1
POSTGRES_PORT = 5432
MQTT_USER= flowsense_backend
MQTT_PASSWORD = backend

# Django security (set these for any shared or production deployment)
DJANGO_DEBUG=True
# DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# DJANGO_ALLOWED_HOSTS=flowsense.auf.edu.ph,192.168.1.20
# DJANGO_CSRF_TRUSTED_ORIGINS=https://flowsense.auf.edu.ph

# Admin sign-in emails. Without SMTP settings they print to the backend and
# celery-worker logs (console backend), which is fine for local testing.
FLOWSENSE_ADMIN_BASE_URL=http://localhost
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=flowsense@auf.edu.ph
# EMAIL_HOST_PASSWORD=app-password
# DEFAULT_FROM_EMAIL=FlowSense <flowsense@auf.edu.ph>
# Only for plain-HTTP access by LAN IP (browsers drop Secure cookies over HTTP):
# ADMIN_SESSION_COOKIE_SECURE=False

# Sign-in code emails
# app password for app 
EMAIL_HOST_USER=flowsense.capstone@gmail

# Frontend / kiosk
# Folder on this machine that holds the building .glb models (default:
# frontend/client/public/models). See docs/setup/building-models.md.
# FLOWSENSE_MODELS_DIR=/srv/flowsense/models


